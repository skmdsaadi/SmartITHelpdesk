# Run: python -m app.setup_local
# The setup command creates a dedicated PostgreSQL user and database.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://helpdesk_app:CHANGE_ME@127.0.0.1:5432/smart_it_helpdesk
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:8000
COOKIE_SECURE=false
SESSION_HOURS=12
ALLOW_REGISTRATION=true
# Hosting settings and one-time admin provisioning: docs/DEPLOYMENT.md.
# Never put DATABASE_URL or administrator passwords in frontend variables.
